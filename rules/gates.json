{
  "version": "1.0",
  "note": "判据规则库。阈值只写在这里, 脚本不硬编码 —— 换芯片/换模型只改本文件与 hw/*.json。severity: error 影响退出码, warn 只提示, info 仅记录。",
  "scope_note": "expr 允许: 四则运算、比较、len/sum/min/max/abs/round/all/any + count_true/all_true/min_of/max_of/pick; 上下文为 results/<name>.json 的键名 (如 s5, s2, s8)。",
  "rules": [
    {
      "id": "ops.struct", "stage": "S2", "severity": "error",
      "desc": "结构算子逐用例数值对齐 (Python↔C++↔torch)",
      "expr": "count_true(s2.op_alignment)",
      "ok_expr": "count_true(s2.op_alignment) == len(s2.op_alignment)",
      "limit": "全部用例 passed",
      "evidence": "results/s2_ops_alignment.md"
    },
    {
      "id": "ops.struct.bit_exact", "stage": "S2", "severity": "error",
      "desc": "位级用例 (fp16 舍入/边界/次正规) 逐 bit 一致率",
      "expr": "min_of(pick(s2.op_alignment, 'kind', 'bit'), 'bit_exact_pct')",
      "op": ">=", "threshold": 100.0,
      "evidence": "results/s2_ops_alignment.md"
    },
    {
      "id": "ops.quant", "stage": "S2", "severity": "error",
      "desc": "量化算子 (INT4/INT8 分组去量化) 数值对齐",
      "expr": "count_true(s2.quant_alignment)",
      "ok_expr": "count_true(s2.quant_alignment) == len(s2.quant_alignment) and max_of(s2.quant_alignment, 'rel_err') <= 1e-5",
      "limit": "全部 passed 且 max rel_err <= 1e-5",
      "evidence": "results/s2_ops_alignment.md"
    },
    {
      "id": "quant.variants", "stage": "S3", "severity": "error",
      "desc": "量化方案覆盖度 (含 AWQ / GPTQ / 混合精度)",
      "expr": "len(s3.variants)",
      "ok_expr": "len(s3.variants) >= 4 and any('awq' in k for k in s3.variants) and any('gptq' in k for k in s3.variants)",
      "limit": ">= 4 档且含 awq / gptq",
      "evidence": "results/s3_quant.md"
    },
    {
      "id": "quant.gptq_gain", "stage": "S3", "severity": "error",
      "desc": "GPTQ 相对同 group RTN 的层输出误差比 (全部矩阵应更优)",
      "expr": "s3.gptq_gain.median_ratio",
      "ok_expr": "s3.gptq_gain.all_better and s3.gptq_gain.median_ratio < 1.0",
      "limit": "全部更优, 中位 < 1.0",
      "evidence": "results/s3_quant.md"
    },
    {
      "id": "quant.awq_gain", "stage": "S3", "severity": "warn",
      "desc": "AWQ 相对 RTN 的层输出误差比",
      "expr": "s3.awq_gain.median_ratio",
      "ok_expr": "s3.awq_gain.median_ratio < 1.0 and s3.awq_gain.better_pct >= 60",
      "limit": "中位 < 1.0 且更优占比 >= 60%",
      "evidence": "results/s3_quant.md"
    },
    {
      "id": "pack.bit_exact", "stage": "S3b", "severity": "error",
      "desc": "硬件权重格式解包逐 bit 一致 (ISS dump vs 参考)",
      "expr": "s7.gates['pack.bit_exact']",
      "op": ">=", "threshold": 100.0,
      "evidence": "results/s3_pack.md"
    },
    {
      "id": "pack.image", "stage": "S3b", "severity": "error",
      "desc": "设备镜像导出与元数据开销",
      "expr": "s3_pack.image.bytes",
      "ok_expr": "s3_pack.image.bytes > 0 and s3_pack.image.metadata_overhead_ratio < 0.10",
      "limit": "元数据开销 < 10%",
      "evidence": "results/s3_pack.md"
    },
    {
      "id": "e2e.logits_cosine_bc", "stage": "S5", "severity": "error",
      "desc": "ISS vs 量化模拟 (prefill logits cosine)",
      "expr": "s5.metrics_bc.logits_cosine_prefill",
      "op": ">=", "threshold": 0.999,
      "evidence": "results/s5_e2e.md"
    },
    {
      "id": "e2e.gen_match_bc", "stage": "S5", "severity": "error",
      "desc": "ISS 与量化模拟的生成 token 一致率",
      "expr": "s5.gen_match_bc",
      "ok_expr": "s5.gen_match_bc.split('/')[0] == s5.gen_match_bc.split('/')[1]",
      "limit": "全部一致",
      "evidence": "results/s5_e2e.md"
    },
    {
      "id": "e2e.logits_cosine_ab", "stage": "S5", "severity": "error",
      "desc": "量化 vs fp32 参考 (logits cosine)",
      "expr": "s5.metrics_ab.logits_cosine",
      "op": ">=", "threshold": 0.9,
      "evidence": "results/s5_e2e.md"
    },
    {
      "id": "e2e.top1_ab", "stage": "S5", "severity": "warn",
      "desc": "量化 vs fp32 参考 (top-1 一致率)",
      "expr": "s5.metrics_ab.top1_agreement",
      "op": ">=", "threshold": 0.6,
      "evidence": "results/s5_e2e.md"
    },
    {
      "id": "perf.ttft_ms", "stage": "S6", "severity": "error",
      "desc": "首 token 延迟 TTFT",
      "expr": "s6.headline.ttft_ms",
      "op": "<=", "threshold": 50.0,
      "evidence": "results/s6_perf.md"
    },
    {
      "id": "perf.tpot_ms", "stage": "S6", "severity": "error",
      "desc": "单 token 延迟 TPOT",
      "expr": "s6.headline.tpot_ms",
      "op": "<=", "threshold": 15.0,
      "evidence": "results/s6_perf.md"
    },
    {
      "id": "perf.dram_per_token", "stage": "S6", "severity": "info",
      "desc": "decode 每 token DRAM 访存量 (瓶颈归因输入)",
      "expr": "s6.headline.decode_dram_bytes_per_token",
      "op": ">", "threshold": 0,
      "evidence": "results/s6_perf.md"
    },
    {
      "id": "regress.all_pass", "stage": "S7", "severity": "error",
      "desc": "门禁回归明细 (gates 字典逐条)",
      "expr": "s7.n_fail",
      "op": "==", "threshold": 0,
      "evidence": "results/s7_regression.md"
    },
    {
      "id": "repeat.deterministic", "stage": "S7", "severity": "error",
      "desc": "同一微码两次运行逐 bit 一致",
      "expr": "s7.gates['repeat.deterministic']",
      "op": "==", "threshold": 1.0,
      "evidence": "results/s7_regression.md"
    },
    {
      "id": "debug.localize", "stage": "S7", "severity": "error",
      "desc": "故障注入能否定位到注入层 (跨层/跨算子定位能力)",
      "expr": "count_true(s7_fault_injection.experiments, 'localized_correct')",
      "ok_expr": "count_true(s7_fault_injection.experiments, 'localized_correct') == len(s7_fault_injection.experiments)",
      "limit": "全部定位正确",
      "evidence": "results/s7_regression.md"
    },
    {
      "id": "vision.align", "stage": "S8", "severity": "error",
      "desc": "视觉编码器 ISS vs 量化模拟 (logits cosine)",
      "expr": "s8.iss_cos_vs_quant",
      "op": ">=", "threshold": 0.95,
      "evidence": "results/s8_vision.md"
    },
    {
      "id": "vision.top1", "stage": "S8", "severity": "error",
      "desc": "视觉编码器 top-1 与 fp32 参考一致",
      "expr": "s8.iss_top1_match",
      "op": "==", "threshold": true,
      "evidence": "results/s8_vision.md"
    },
    {
      "id": "vision.multimodal", "stage": "S8", "severity": "error",
      "desc": "视觉 token 进 LLM: logits 健全性 + KV Cache 无越界",
      "expr": "s8.multimodal.kv_peak_bytes",
      "ok_expr": "s8.multimodal_logits_finite and s8.multimodal.kv_peak_bytes > 0 and s8.multimodal.seq >= 200",
      "limit": "全有限且序列长度/ KV 合理",
      "evidence": "results/s8_vision.md"
    },
    {
      "id": "realhw.acl_exec", "stage": "真机", "severity": "warn",
      "desc": "真机 Ascend: .om 在设备上执行成功 (日志留证)",
      "expr": "1",
      "ok_expr": "os.path.exists(os.path.join(ROOT, 'results/logs/ascend_real_hw.log'))",
      "limit": "存在真机执行日志",
      "evidence": "results/npu_real_hw.md"
    }
  ],
  "freshness": [
    {"stage": "S1 模型分析与部署规划", "result": "results/s1_model_analysis.json", "sources": ["s1_analyze_model.py", "mtx_common.py"]},
    {"stage": "S2 算子适配与验证", "result": "results/s2_ops_alignment.json", "sources": ["s2_align.py", "mtx_ops_ref.py", "s2_ops_native.cpp"]},
    {"stage": "S3 量化与精度优化", "result": "results/s3_quant.json", "sources": ["s3_quant.py", "mtx_qwen.py"]},
    {"stage": "S3b 权重打包与镜像", "result": "results/s3_pack.json", "sources": ["s3_pack.py", "s3_quant.py"]},
    {"stage": "S4a 微码生成", "result": "build/npu_program_w4a16_rtn_mix8_kvfp16.mtx", "sources": ["s4_gen_program.py", "s3_pack.py"]},
    {"stage": "S4b ISS 可执行", "result": "build/npu_iss", "sources": ["s4_iss.cpp"]},
    {"stage": "S5 端到端集成与数值对齐", "result": "results/s5_e2e.json", "sources": ["s5_e2e.py", "mtx_qwen.py", "mtx_ops_ref.py"]},
    {"stage": "S6 性能分析与瓶颈归因", "result": "results/s6_perf.json", "sources": ["s6_perf.py"]},
    {"stage": "S7 回归门禁与问题定位", "result": "results/s7_regression.json", "sources": ["s7_regress.py", "mtx_qwen.py"]},
    {"stage": "S8 视觉编码器与多模态链路", "result": "results/s8_vision.json", "sources": ["s8_vision.py", "mtx_vit.py", "s3_quant.py", "s3_pack.py", "mtx_ops_ref.py"]},
    {"stage": "S9 汇总报告", "result": "results/SUMMARY.md", "sources": ["s9_report.py"]}
  ]
}
